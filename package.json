{
  "name": "officejs-doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/verify-docs.mjs",
    "verify": "node scripts/verify-docs.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:cloudflare": "npm run build && npm --userconfig=/dev/null exec --yes --package=wrangler@4.101.0 -- wrangler pages deploy dist --project-name officejs-doc --commit-dirty=true"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.6"
  }
}
